# Church Platform — Root .htaccess
# For shared hosting: routes requests to public/ subfolder
# This file is auto-generated by the installer too.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to public/ files (assets, index.php, etc.)
    RewriteRule ^public/ - [L]

    # Route everything else through public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Security: block access to sensitive files
<FilesMatch "^(\.env|composer\.(json|lock)|artisan|socket-server\.php|package\.json|package-lock\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
